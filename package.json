{
  "name": "careerforge",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:clean": "node -e \"require('fs').rmSync('.next',{recursive:true,force:true})\" && next dev",
    "py:dev": "python python_ai/server.py",
    "build": "next build",
    "build:clean": "node -e \"require('fs').rmSync('.next',{recursive:true,force:true})\" && next build",
    "start": "next start",
    "lint": "next lint",
    "lint:tokens": "node scripts/lint_design_tokens.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/lint_design_tokens.mjs && node --import tsx --test tests/unit/*.test.mjs",
    "test:unit": "node --import tsx --test tests/unit/*.test.mjs",
    "test:voice-stress": "node test_voice_stress.mjs",
    "test:voice-conversation": "node test_voice_conversation.mjs",
    "test:voice": "node test_voice_conversation.mjs && node test_voice_stress.mjs"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.65",
    "@ai-sdk/google": "^4.0.82",
    "@ai-sdk/groq": "^4.0.50",
    "@ai-sdk/openai": "^4.0.78",
    "@openrouter/ai-sdk-provider": "^3.1.0",
    "@supabase/ssr": "^0.12.5",
    "@supabase/supabase-js": "^2.112.4",
    "@types/three": "^0.186.0",
    "ai": "^7.0.118",
    "lucide-react": "^1.48.0",
    "mammoth": "^1.12.1",
    "next": "^14.2.35",
    "pdf-parse": "^2.4.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "three": "^0.186.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "autoprefixer": "^10.4.19",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.35",
    "postcss": "^8.4.40",
    "tailwindcss": "^3.4.7",
    "tsx": "^4.23.15",
    "typescript": "^5.5.4"
  }
}
