# ─── Google OAuth & Maps ───────────────────────────────────────────────────────
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# ─── Supabase Database ────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ─── Free AI Engines & Models (Zero-cost / Free Tiers) ────────────────────────
# 1. Groq Cloud API (Free Tier - Llama 3.3 70B & Whisper-Large-v3 STT)
# Sign up free at: https://console.groq.com/
GROQ_API_KEY=

# 2. Google AI Studio (Free Tier - Gemini 1.5 Flash - 15 RPM free)
# Get key free at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# 3. GitHub Models API (Free Tier - LLaMA 3.3 70B, GPT-4o-mini, Mistral)
# Use GitHub Personal Access Token at: https://github.com/settings/tokens
GITHUB_TOKEN=

# 4. Hugging Face Serverless (Free Open-Source API)
# Get token free at: https://huggingface.co/settings/tokens
HF_TOKEN=

# ─── Free Job Scraping & Salary APIs (Optional Free Tiers) ─────────────────────
# 1. Adzuna Job Search API (Free Developer Key)
# Sign up at: https://developer.adzuna.com/
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# 2. SerpApi Google Jobs API (100 free searches/month)
# Sign up at: https://serpapi.com/
SERPAPI_API_KEY=

# ─── Cloud Voice & Audio (Optional - Browser Native Web Speech is Default & Unlimited) ──
# 1. ElevenLabs TTS (10,000 free chars/month)
# Sign up at: https://elevenlabs.io/
ELEVENLABS_API_KEY=

# 2. Deepgram STT ($200 free credit)
# Sign up at: https://deepgram.com/
DEEPGRAM_API_KEY=
