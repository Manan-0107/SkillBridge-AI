# ==============================================================================
# CareerForge Authoritative Environment Contract
# ==============================================================================
# Security Classification:
# - NEXT_PUBLIC_*: Exposed to browser (MUST NOT contain secrets or service keys)
# - All other variables: Server-only (secrets never leaked to client)
# ==============================================================================

# ─── 1. Authentication & Security (Server-only Secret) ────────────────────────
# Secret key used for HMAC-SHA256 session token signatures (cf_session cookie).
# In production, set to a strong 32+ character random string.
SESSION_SECRET=careerforge-production-session-secret-change-in-production-deployments

# ─── 2. Google OAuth & Maps (Browser Public) ──────────────────────────────────
# Required for Google One-Tap sign-in and Google Map reverse geocoding
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# ─── 3. Supabase Database (Browser Public & Server) ───────────────────────────
# Required for database persistence (users, profile, resume uploads)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ─── 4. Central Multi-Provider AI Cascade (Server-only Secrets) ───────────────
# At least one provider is recommended for full generative AI capabilities.
# The system automatically cascades: Gemini -> Groq -> OpenAI -> OpenRouter -> Local Reasoner.

# 1. Google AI Studio (Recommended Primary - Gemini 1.5 & 2.0 Flash)
# Get free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# 2. Groq Cloud (Recommended Secondary - Ultra-fast Llama 3.3 70B & Whisper-Large-v3 STT)
# Sign up free at: https://console.groq.com/
GROQ_API_KEY=

# 3. OpenAI (GPT-4o-mini & GPT-4o)
# Get key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# 4. OpenRouter (Optional Open-Source Model Gateway)
# Get key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# ─── 5. Optional Python AI Service (Server-only) ──────────────────────────────
# Only set if running external FastAPI/Python microservice container.
# If unset, CareerForge runs 100% on the native TypeScript server-side AI cascade.
# PYTHON_AI_SERVICE_URL=http://127.0.0.1:8000

# ─── 6. Job Search APIs (Optional Free Tiers - Server-only) ───────────────────
# 1. Adzuna Job Search API
# Developer portal: https://developer.adzuna.com/
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# 2. SerpApi Google Jobs API
# Developer portal: https://serpapi.com/
SERPAPI_API_KEY=

# ─── 7. Cloud Voice & Audio (Optional Server-only Secrets) ─────────────────────
# Note: Unlimited native browser Web Speech API (STT & TTS) is always active by default.

# 1. ElevenLabs TTS (Multilingual v2)
# Developer portal: https://elevenlabs.io/
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# 2. Sarvam AI (Indic Language TTS / STT - Bulbul & Saarika)
# Developer portal: https://www.sarvam.ai/
SARVAM_API_KEY=

# 3. Deepgram STT (Nova-2 Speech-to-Text)
# Developer portal: https://deepgram.com/
DEEPGRAM_API_KEY=
