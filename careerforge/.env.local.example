# Google OAuth web client ID (APIs & Services → Credentials → OAuth 2.0 Client ID)
# Application type: Web application
# Authorized JavaScript origins: http://localhost:3000
# Authorized redirect URIs: http://localhost:3000
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Google Maps Places API (for Local Opportunities module)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# ─── Supabase Database ────────────────────────────────────────────────────────
# Create a free project at https://supabase.com
# Dashboard → Settings → API → Project URL and Project API Keys (anon/public)
# Then run the SQL in lib/db.ts to create the tables.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ─── AI Resume Analysis ───────────────────────────────────────────────────────
# Gemini 1.5 Flash (free tier) — get key at https://aistudio.google.com/app/apikey
# Without this key, the app uses 2 engines (heuristic + GitHub) instead of 3.
GEMINI_API_KEY=

# Optional: RapidAPI Resume Parser (freemium) — get key at https://rapidapi.com
# RAPIDAPI_KEY=
