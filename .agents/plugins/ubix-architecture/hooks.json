{
  "ubix-architecture-guard": {
    "enabled": true,
    "PreToolUse": [
      {
        "matcher": "write_to_file|replace_file_content",
        "hooks": [
          {
            "type": "command",
            "command": "node ./scripts/arch-governance-hook.mjs",
            "timeout": 5
          }
        ]
      }
    ],
    "PreInvocation": [
      {
        "type": "command",
        "command": "node ./scripts/pre-invocation-reminder.mjs",
        "timeout": 5
      }
    ]
  }
}
