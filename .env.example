# ==============================================================================
# UBIX / CareerForge Authoritative Environment Contract (.env.example)
# ==============================================================================
# Classification:
# - NEXT_PUBLIC_*: Exposed to browser (MUST NOT contain secrets or service keys)
# - All other variables: Server-only (secrets never leaked to client)
# ==============================================================================

# ─── 1. Authentication & Security (Server-only Secret - MANDATORY) ────────────
# Strong random string (minimum 32 characters) for HMAC-SHA256 session token signatures.
SESSION_SECRET=YOUR_32_CHAR_SESSION_SECRET_HERE

# ─── 2. Supabase Persistence (MANDATORY for persistence) ──────────────────────
# Public project URL and anon key for database queries and RLS enforcement.
NEXT_PUBLIC_SUPABASE_URL=YOUR_SUPABASE_PROJECT_URL
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
# Optional server-only service-role key (used exclusively for server-side curriculum RAG search)
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# ─── 3. Canonical AI Provider (Server-only Secret - MANDATORY for AI) ─────────
# Default: openai with gpt-4o-mini
AI_PROVIDER=openai
OPENAI_API_KEY=YOUR_OPENAI_API_KEY
OPENAI_MODEL_ID=gpt-4o-mini

# Optional AI alternatives & cascade fallbacks:
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
GEMINI_MODEL=gemini-3.5-flash-lite
GROQ_API_KEY=YOUR_GROQ_API_KEY
GROQ_MODEL_ID=llama-3.3-70b-versatile
ANTHROPIC_API_KEY=YOUR_ANTHROPIC_API_KEY
ANTHROPIC_MODEL_ID=claude-sonnet-4-5
OPENROUTER_API_KEY=YOUR_OPENROUTER_API_KEY
OPENROUTER_MODEL_ID=meta-llama/llama-3.3-70b-instruct:free

# ─── 4. Distributed Rate Limiting (Server-only - RECOMMENDED for Serverless) ──
# If omitted, system falls back to in-memory sliding window per instance.
UPSTASH_REDIS_REST_URL=YOUR_UPSTASH_REDIS_REST_URL
UPSTASH_REDIS_REST_TOKEN=YOUR_UPSTASH_REDIS_REST_TOKEN

# ─── 5. Cloud Voice & Audio (Optional Server-only Secrets) ─────────────────────
# Note: Native in-browser Web Speech API (STT & TTS) is always active by default.
ELEVENLABS_API_KEY=YOUR_ELEVENLABS_API_KEY
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
SARVAM_API_KEY=YOUR_SARVAM_API_KEY
AZURE_SPEECH_KEY=YOUR_AZURE_SPEECH_KEY
AZURE_SPEECH_REGION=eastus
GOOGLE_SPEECH_API_KEY=YOUR_GOOGLE_SPEECH_API_KEY

# ─── 6. Email Dispatch (Optional Server-only Secret) ──────────────────────────
# Used for real-time job alert email delivery via Resend API
RESEND_API_KEY=YOUR_RESEND_API_KEY

# ─── 7. Job Search APIs (Optional Server-only Secrets) ────────────────────────
# If omitted, system falls back to platform curated job directory.
ADZUNA_APP_ID=YOUR_ADZUNA_APP_ID
ADZUNA_APP_KEY=YOUR_ADZUNA_APP_KEY
SERPAPI_API_KEY=YOUR_SERPAPI_API_KEY

# ─── 8. Google OAuth & Maps (Optional Browser Public) ─────────────────────────
NEXT_PUBLIC_GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY

# ─── 9. Optional Microservices & Voice Stream Server ──────────────────────────
# Only if running external Python AI service or standalone WebSocket stream server:
PYTHON_AI_SERVICE_URL=http://127.0.0.1:8000
NEXT_PUBLIC_VOICE_STREAM_PORT=8081
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
